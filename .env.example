# KINETIX FITNESS PLATFORM: ENVIRONMENT CONFIGURATION
# Connect to your Supabase Project (PostgreSQL, Auth, Storage)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: If these keys are not set, Kinetix runs in resilient Offline-First Local Storage mode
